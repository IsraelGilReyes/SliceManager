datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client-js"
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]

  @@map("roles")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  roleId    Int      @map("role_id")
  role      Role     @relation(fields: [roleId], references: [id])

  @@map("users")
}