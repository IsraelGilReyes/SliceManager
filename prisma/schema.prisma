generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]

  @@map("roles")
}

model User {
  id            Int            @id @default(autoincrement())
  roleId         Int            @map("role_id")
  name           String
  email          String         @unique
  password       String
  isActive       Boolean        @default(true) @map("is_active")
  createdAt      DateTime       @default(now()) @map("created_at")
  cashRegisters  CashRegister[]
  orders         Order[]
  role           Role           @relation(fields: [roleId], references: [id])

  @@index([roleId], map: "users_role_id_fkey")
  @@map("users")
}

model Product {
  id                Int           @id @default(autoincrement())
  name              String        @unique
  extraPriceFull    Decimal       @default(0.00) @map("extra_price_full") @db.Decimal(10, 2)
  extraPriceHalf    Decimal       @default(0.00) @map("extra_price_half") @db.Decimal(10, 2)
  isActive          Boolean       @default(true) @map("is_active")
  createdAt         DateTime      @default(now()) @map("created_at")
  orderDetailsLeft  OrderDetail[] @relation("FlavorLeft")
  orderDetailsRight OrderDetail[] @relation("FlavorRight")

  @@map("products")
}

model PizzaSize {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  price        Decimal       @db.Decimal(10, 2)
  orderDetails OrderDetail[]

  @@map("pizza_sizes")
}

model Promotion {
  id          Int      @id @default(autoincrement())
  description String
  discount    Decimal  @db.Decimal(10, 2)
  startDate   DateTime @map("start_date")
  endDate     DateTime @map("end_date")
  isActive    Boolean  @default(true) @map("is_active")
  orders      Order[]

  @@map("promotions")
}

model Order {
  id           Int           @id @default(autoincrement())
  userId       Int           @map("user_id")
  promoId      Int?          @map("promo_id")
  total        Decimal       @db.Decimal(10, 2)
  status       OrderStatus   @default(PENDIENTE)
  createdAt    DateTime      @default(now()) @map("created_at")
  orderDetails OrderDetail[]
  promotion    Promotion?    @relation(fields: [promoId], references: [id])
  user         User          @relation(fields: [userId], references: [id])

  @@index([promoId], map: "orders_promo_id_fkey")
  @@index([userId], map: "orders_user_id_fkey")
  @@map("orders")
}

model OrderDetail {
  id            Int       @id @default(autoincrement())
  orderId       Int       @map("order_id")
  sizeId        Int       @map("size_id")
  flavorLeftId  Int       @map("flavor_left_id")
  flavorRightId Int?      @map("flavor_right_id")
  quantity      Int       @default(1)
  price         Decimal   @db.Decimal(10, 2)
  subtotal      Decimal   @db.Decimal(10, 2)

  flavorLeft    Product   @relation("FlavorLeft", fields: [flavorLeftId], references: [id])
  flavorRight   Product?  @relation("FlavorRight", fields: [flavorRightId], references: [id])
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  size          PizzaSize @relation(fields: [sizeId], references: [id])

  @@index([flavorLeftId], map: "order_details_flavor_left_id_fkey")
  @@index([flavorRightId], map: "order_details_flavor_right_id_fkey")
  @@index([orderId], map: "order_details_order_id_fkey")
  @@index([sizeId], map: "order_details_size_id_fkey")
  @@map("order_details")
}

model CashRegister {
  id            Int        @id @default(autoincrement())
  userId        Int        @map("user_id")
  openingAmount Decimal    @map("opening_amount") @db.Decimal(10, 2)
  closingAmount Decimal?   @map("closing_amount") @db.Decimal(10, 2)
  openedAt      DateTime   @default(now()) @map("opened_at")
  closedAt      DateTime?  @map("closed_at")
  status        CashStatus @default(ABIERTA)

  user          User       @relation(fields: [userId], references: [id])

  @@index([userId], map: "cash_registers_user_id_fkey")
  @@map("cash_registers")
}

enum OrderStatus {
  PENDIENTE
  PREPARANDO
  ENVIADO
  ENTREGADO
  CANCELADO
}

enum CashStatus {
  ABIERTA
  CERRADA
}